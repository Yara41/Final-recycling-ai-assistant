# Copy to .env.local for local development (.env.local is git-ignored).
# Both values are PUBLIC and safe in browser code. Put the same two variables in
# Netlify -> Site configuration -> Environment variables.
#
# NEVER put the service_role key, an sb_secret_ key, GEMINI_API_KEY or GROQ_API_KEY
# in a VITE_ variable. AI keys live only in Supabase Edge Function secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-legacy-anon-public-key-here
